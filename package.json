{
  "name": "dsh-auto-archive",
  "version": "0.1.0",
  "description": "Conversation-length guard for DeepSeek Harness: archive a long session to Markdown and open a fresh session before the context (and the bill) gets out of hand.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "archive",
    "context",
    "tokens"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./digest": "./lib/digest.js",
    "./config": "./lib/config.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
